{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        { "name": "Ink", "slug": "ink", "color": "#0f172a" },
        { "name": "Canvas", "slug": "canvas", "color": "#ffffff" },
        { "name": "Blue", "slug": "blue", "color": "#5166ec" },
        { "name": "Yellow", "slug": "yellow", "color": "#f9de42" },
        { "name": "Slate", "slug": "slate", "color": "#64748b" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "System",
          "slug": "system"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--canvas)",
      "text": "var(--wp--preset--color--ink)"
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        }
      }
    }
  }
}