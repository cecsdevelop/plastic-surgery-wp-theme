{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "820px",
            "wideSize": "1536px"
        },
        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "name": "White",
                    "slug": "white",
                    "color": "#ffffff"
                },
                {
                    "name": "Gray 100",
                    "slug": "gray-100",
                    "color": "#f5f3f3"
                },
                {
                    "name": "Gray 200",
                    "slug": "gray-200",
                    "color": "#ebe6e6"
                },
                {
                    "name": "Gray 300",
                    "slug": "gray-300",
                    "color": "#d8cfce"
                },
                {
                    "name": "Gray 400",
                    "slug": "gray-400",
                    "color": "#b09f9d"
                },
                {
                    "name": "Gray 600",
                    "slug": "gray-600",
                    "color": "#5b5a5a"
                },
                {
                    "name": "Graphite",
                    "slug": "graphite",
                    "color": "#383737"
                },
                {
                    "name": "Ink",
                    "slug": "ink",
                    "color": "#151414"
                },
                {
                    "name": "Black",
                    "slug": "black",
                    "color": "#080808"
                },
                {
                    "name": "Red",
                    "slug": "red",
                    "color": "#e73728"
                },
                {
                    "name": "Red dark",
                    "slug": "red-dark",
                    "color": "#a4271c"
                },
                {
                    "name": "Maroon",
                    "slug": "maroon",
                    "color": "#3a0e0a"
                },
                {
                    "name": "Cocoa",
                    "slug": "cocoa",
                    "color": "#613e3b"
                },
                {
                    "name": "Slate blue",
                    "slug": "slate-blue",
                    "color": "#37474f"
                }
            ],
            "gradients": [
                {
                    "name": "Dark",
                    "slug": "dark",
                    "gradient": "linear-gradient(180deg, #000000 0%, #666666 100%)"
                }
            ]
        },
        "typography": {
            "fontFamilies": [
                {
                    "name": "DM Sans",
                    "slug": "dm-sans",
                    "fontFamily": "\"DM Sans\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "DM Sans",
                            "fontStyle": "normal",
                            "fontWeight": "100 1000",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/dm-sans-variable-latin.woff2"
                            ]
                        },
                        {
                            "fontFamily": "DM Sans",
                            "fontStyle": "italic",
                            "fontWeight": "100 1000",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/dm-sans-variable-italic-latin.woff2"
                            ]
                        }
                    ]
                },
                {
                    "name": "DM Serif Text",
                    "slug": "dm-serif-text",
                    "fontFamily": "\"DM Serif Text\", Georgia, \"Times New Roman\", serif",
                    "fontFace": [
                        {
                            "fontFamily": "DM Serif Text",
                            "fontStyle": "normal",
                            "fontWeight": "400",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/dm-serif-text-latin.woff2"
                            ]
                        },
                        {
                            "fontFamily": "DM Serif Text",
                            "fontStyle": "italic",
                            "fontWeight": "400",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/dm-serif-text-italic-latin.woff2"
                            ]
                        }
                    ]
                },
                {
                    "name": "Cormorant Garamond",
                    "slug": "cormorant-garamond",
                    "fontFamily": "\"Cormorant Garamond\", Georgia, \"Times New Roman\", serif",
                    "fontFace": [
                        {
                            "fontFamily": "Cormorant Garamond",
                            "fontStyle": "normal",
                            "fontWeight": "300 700",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/cormorant-garamond-variable-latin.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Cormorant Garamond",
                            "fontStyle": "italic",
                            "fontWeight": "300 700",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/cormorant-garamond-variable-italic-latin.woff2"
                            ]
                        }
                    ]
                },
                {
                    "name": "Raleway",
                    "slug": "raleway",
                    "fontFamily": "\"Raleway\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Raleway",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/Raleway.woff2"
                            ]
                        },
                        {
                            "fontFamily": "Raleway",
                            "fontStyle": "italic",
                            "fontWeight": "100 900",
                            "fontDisplay": "swap",
                            "src": [
                                "file:./assets/fonts/raleway-variable-italic-latin.woff2"
                            ]
                        }
                    ]
                },
                {
                    "name": "System",
                    "slug": "system",
                    "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
                }
            ]
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--white)",
            "text": "var(--wp--preset--color--black)"
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--red)"
                }
            }
        }
    }
}
